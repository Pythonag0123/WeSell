<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>WESELL - My Orders</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/order.css">
</head>
<body>
  <!-- Navbar -->
  <div class="navbar">
    <div class="logo">🛍️ WESELL</div>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>

      <% if (currentUser) { %>
        <span class="ms-3">Welcome, <%= currentUser.username %></span>
        <% if (currentUser.role === "buyer") { %>
          <a href="#" onclick="openCart()">Cart (<span id="cartCount"><%= cartCount || 0 %></span>)</a>
          <a href="/orders" class="fw-bold">Orders</a>
        <% } else if (currentUser.role === "seller") { %>
          <a href="/dashboard">Dashboard</a>
        <% } %>
        <a href="/logout">Logout</a>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/signup">Signup</a>
      <% } %>
    </div>
  </div>

  <div class="container mt-4">
    <h1 class="page-header">📦 My Orders</h1>

    <% if (orders.length === 0) { %>
      <div class="alert alert-info rounded-3">You have no orders yet.</div>
    <% } else { %>
      <% orders.forEach(order => { %>
        <div class="order-card mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5><%= order.product.name %></h5>
            <span class="status-badge 
              <%= order.status === 'Pending' ? 'bg-warning text-dark' : 
                  order.status === 'Shipped' ? 'bg-info text-white' : 
                  order.status === 'Delivered' ? 'bg-success text-white' : 
                  'bg-danger text-white' %>">
              <%= order.status %>
            </span>
          </div>

          <p>🛒 Quantity: <%= order.quantity %></p>
          <p>💰 Total: ₹<%= order.totalPrice %></p>
          <p>📍 Address: <%= order.shippingDetails.address %>, <%= order.shippingDetails.pincode %></p>
          <p>📞 Phone: <%= order.shippingDetails.phone %></p>
          <small class="text-muted">Ordered on <%= order.createdAt.toDateString() %></small>

          <% if (order.status === "Delivered") { %>
            <hr>
            <form method="POST" action="/review/<%= order.product._id %>">
              <div class="mb-2">
                <label for="rating-<%= order._id %>">⭐ Rate Product:</label>
                <select id="rating-<%= order._id %>" name="rating" class="form-select" required>
                  <option value="">Select Rating</option>
                  <option value="1">⭐</option>
                  <option value="2">⭐⭐</option>
                  <option value="3">⭐⭐⭐</option>
                  <option value="4">⭐⭐⭐⭐</option>
                  <option value="5">⭐⭐⭐⭐⭐</option>
                </select>
              </div>
              <div class="mb-2">
                <textarea name="comment" rows="2" class="form-control" placeholder="Write a review..." required></textarea>
              </div>
              <button type="submit" class="btn btn-gradient btn-sm w-100">Submit Review</button>
            </form>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function openCart() {
      alert("Cart functionality coming soon!");
    }
  </script>
</body>
</html>
